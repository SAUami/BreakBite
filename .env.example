# -----------------------------------------------
# BreakBite Environment Configuration
# -----------------------------------------------

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Note: If omitted or unreachable, BreakBite automatically boots an In-Memory MongoDB instance!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/breakbite?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=breakbite_hackathon_super_secret_jwt_key_2026

# Client URL (for CORS and Socket.io)
CLIENT_URL=http://localhost:5173

# Bell-Sync Engine Settings
CAMPUS_WALK_MINUTES=4
MAX_ORDERS_PER_SLOT=5
KITCHEN_CAPACITY_PREP_MINUTES=40

# Client Vite Environment Variables (in /client/.env)
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
